# Backend REST API base URL (used for file uploads)
# In production, set to your backend cloud URL (e.g. https://api.truefellow.pk or https://truefellow-server.onrender.com)
VITE_API_URL=http://localhost:4000

# Backend GraphQL endpoint URL
# In production, set to your backend GraphQL URL (e.g. https://api.truefellow.pk/graphql)
VITE_GRAPHQL_URI=http://localhost:4000/graphql
